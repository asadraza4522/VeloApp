# Copy to .env.local (gitignored). Only PUBLIC values belong here — anything EXPO_PUBLIC_* ships in the app bundle.
# Never put service-role/secret keys in this file.
EXPO_PUBLIC_DISTRIBUTION=full            # full | lite
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=                # publishable (anon) key only

# Dev only: call a worker on your LAN directly (scripts/dev-worker.sh --lan prints these two lines).
# Leave unset for any real build; setting it enables cleartext HTTP in the Android manifest.
# EXPO_PUBLIC_DEV_WORKER_URL=http://192.168.x.x:8080
# EXPO_PUBLIC_DEV_WORKER_SECRET=

# Monetization (release builds only; dev builds use Google's test ads automatically)
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/WWWWWWWWWW
# EXPO_PUBLIC_ADMOB_TEST_DEVICE=<your device id from logcat>   # so your own ad views are test traffic
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...   # Lite (Play) build only
