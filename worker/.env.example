# Secrets are set with `fly secrets set` in production; this file is for local runs only.
WORKER_SHARED_SECRET=change-me            # Edge Functions send: Authorization: Bearer <this>
RESOLVER_TIMEOUT_SECONDS=25
MAX_CONCURRENCY=8
# Some hosts (e.g. Wikimedia) require a descriptive UA with contact info:
RESOLVER_USER_AGENT=Mozilla/5.0 (compatible; VeloResolver/1.0)
# Optional: report resolver health to Supabase (service key stays server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
